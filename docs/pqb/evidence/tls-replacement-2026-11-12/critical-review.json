      ]
    },
    "CVE-2026-19445": {
      "disposition": "not-reachable-in-supported-worker",
      "reason": "The issue requires a TLS server with an SNI callback switching SSLContext lifetimes. This image runs a one-shot outbound S3 client and CUDA subprocess, with no Python TLS listener/SNI callback. The upstream advisory excludes TLS clients. Package remains installed and Ubuntu still lists Needs evaluation.",
      "primarySources": [
        "https://mail.python.org/archives/list/security-announce@python.org/thread/QMQIUQB6WGGC3MI7I3WKQXOYOBDSPPS3/",
        "https://ubuntu.com/security/CVE-2026-19445"
      ]
    },
    "CVE-2026-118131": {
      "disposition": "platform-not-applicable",
      "reason": "The reported exploit requires Windows ProgramData DACL inheritance and GnuPG 2.5.21 for Windows. This artifact is Linux/amd64 Ubuntu 22.04, with GnuPG 2.2.27 packages, and the worker does not invoke GnuPG. This is workload/platform triage, not a claim Ubuntu has fixed the CVE.",
      "primarySources": [
        "https://ubuntu.com/security/CVE-2026-118131",

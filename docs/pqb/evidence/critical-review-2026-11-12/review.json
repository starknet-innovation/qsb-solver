  "remediation": {
    "status": "source-patch-and-local-overlay-tested; no replacement qualified image",
    "entrypointSha256": "05407fe9a6c20bfd7aa31c590cf61e40f0ea63cbbf78aa9e1f6ff738f5552f29",
    "change": "Pass verify=/etc/ssl/certs/ca-certificates.crt explicitly to the S3 client. Preserve certificate/hostname verification, timeouts, one-attempt transport and independent CPU checks.",
    "evidence": "System bundle rejects all 16 offline bad chains and all 14 live test hosts; valid TLS control succeeds. Read-only entrypoint overlay passes real installed SDK selection, all 16 chains, Amazon root positive control, no-GPU and parser regressions.",
    "limits": "This mitigates the worker transport through the tested system trust store. It does not patch CPython globally or modify the original image. A fresh committed build and artifact qualification are required before publication."
  },
  "scopeLimits": [
    "Review covers the 20 Critical package matches, not all High/Medium findings or a full security audit",
    "No evidence of an actual attack on prior work; tests used public disclosure endpoints without credentials or HTTP/AWS API calls",
